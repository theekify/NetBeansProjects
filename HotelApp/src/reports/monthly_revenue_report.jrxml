<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="monthly_revenue_report" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <parameter name="OccupancyRate" class="java.lang.String"/>
    <parameter name="ReportMonth" class="java.lang.String"/>

    <queryString>
        <![CDATA[
            SELECT g.full_name AS guest_name,
                   r.room_number,
                   rt.type_name AS room_type,
                   b.check_in_date,
                   b.check_out_date,
                   i.room_charge,
                   i.service_charge,
                   i.total_amount,
                   i.payment_status,
                   i.generated_at
            FROM invoices i
            JOIN bookings b ON i.booking_id = b.id
            JOIN guests g ON b.guest_id = g.id
            JOIN rooms r ON b.room_id = r.id
            JOIN room_types rt ON r.room_type_id = rt.id
            WHERE MONTH(i.generated_at) = MONTH(CURRENT_DATE)
              AND YEAR(i.generated_at) = YEAR(CURRENT_DATE)
            ORDER BY i.generated_at DESC
        ]]>
    </queryString>

    <field name="guest_name" class="java.lang.String"/>
    <field name="room_number" class="java.lang.String"/>
    <field name="room_type" class="java.lang.String"/>
    <field name="check_in_date" class="java.sql.Date"/>
    <field name="check_out_date" class="java.sql.Date"/>
    <field name="room_charge" class="java.math.BigDecimal"/>
    <field name="service_charge" class="java.math.BigDecimal"/>
    <field name="total_amount" class="java.math.BigDecimal"/>
    <field name="payment_status" class="java.lang.String"/>
    <field name="generated_at" class="java.sql.Timestamp"/>

    <variable name="TotalRevenue" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{total_amount}]]></variableExpression>
    </variable>
    <variable name="InvoiceCount" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{total_amount}]]></variableExpression>
    </variable>

    <title>
        <band height="70">
            <textField>
                <reportElement x="0" y="0" width="802" height="30"/>
                <textElement>
                    <font size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Monthly Revenue Report - " + $P{ReportMonth}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="32" width="802" height="20"/>
                <textElement>
                    <font size="11"/>
                </textElement>
                <textFieldExpression><![CDATA["Boutique Hotel Reservation & Guest Management System   |   Current Occupancy: " + $P{OccupancyRate}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="55" width="802" height="1"/>
            </line>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <staticText>
                <reportElement x="0" y="0" width="120" height="24" backcolor="#DDDDDD" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement><font isBold="true" size="10"/></textElement>
                <text><![CDATA[Guest]]></text>
            </staticText>
            <staticText>
                <reportElement x="120" y="0" width="60" height="24" backcolor="#DDDDDD" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement><font isBold="true" size="10"/></textElement>
                <text><![CDATA[Room]]></text>
            </staticText>
            <staticText>
                <reportElement x="180" y="0" width="90" height="24" backcolor="#DDDDDD" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement><font isBold="true" size="10"/></textElement>
                <text><![CDATA[Room Type]]></text>
            </staticText>
            <staticText>
                <reportElement x="270" y="0" width="90" height="24" backcolor="#DDDDDD" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement><font isBold="true" size="10"/></textElement>
                <text><![CDATA[Check-in]]></text>
            </staticText>
            <staticText>
                <reportElement x="360" y="0" width="90" height="24" backcolor="#DDDDDD" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement><font isBold="true" size="10"/></textElement>
                <text><![CDATA[Check-out]]></text>
            </staticText>
            <staticText>
                <reportElement x="450" y="0" width="90" height="24" backcolor="#DDDDDD" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right"><font isBold="true" size="10"/></textElement>
                <text><![CDATA[Room Charge]]></text>
            </staticText>
            <staticText>
                <reportElement x="540" y="0" width="90" height="24" backcolor="#DDDDDD" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right"><font isBold="true" size="10"/></textElement>
                <text><![CDATA[Service Charge]]></text>
            </staticText>
            <staticText>
                <reportElement x="630" y="0" width="90" height="24" backcolor="#DDDDDD" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right"><font isBold="true" size="10"/></textElement>
                <text><![CDATA[Total]]></text>
            </staticText>
            <staticText>
                <reportElement x="720" y="0" width="82" height="24" backcolor="#DDDDDD" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font isBold="true" size="10"/></textElement>
                <text><![CDATA[Status]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="120" height="20"/>
                <box><pen lineWidth="0.3"/></box>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{guest_name}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="120" y="0" width="60" height="20"/>
                <box><pen lineWidth="0.3"/></box>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{room_number}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="180" y="0" width="90" height="20"/>
                <box><pen lineWidth="0.3"/></box>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{room_type}]]></textFieldExpression>
            </textField>
            <textField pattern="yyyy-MM-dd">
                <reportElement x="270" y="0" width="90" height="20"/>
                <box><pen lineWidth="0.3"/></box>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{check_in_date}]]></textFieldExpression>
            </textField>
            <textField pattern="yyyy-MM-dd">
                <reportElement x="360" y="0" width="90" height="20"/>
                <box><pen lineWidth="0.3"/></box>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{check_out_date}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="450" y="0" width="90" height="20"/>
                <box><pen lineWidth="0.3"/></box>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{room_charge}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="540" y="0" width="90" height="20"/>
                <box><pen lineWidth="0.3"/></box>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{service_charge}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="630" y="0" width="90" height="20"/>
                <box><pen lineWidth="0.3"/></box>
                <textElement textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{total_amount}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="720" y="0" width="82" height="20"/>
                <box><pen lineWidth="0.3"/></box>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{payment_status}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="60">
            <line>
                <reportElement x="0" y="10" width="802" height="1"/>
            </line>
            <textField>
                <reportElement x="0" y="20" width="200" height="20"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA["Total Invoices: " + $V{InvoiceCount}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="540" y="20" width="180" height="25"/>
                <textElement textAlignment="Right"><font size="14" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Total Revenue: Rs. " + $V{TotalRevenue}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
